# DevFolio Backend Environment Variables
SECRET_KEY=django-insecure-devfolio-local-dev-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1


CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database configuration (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=devfolio
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Anonymous public API throttling; intentionally raised to absorb the app's initial page-load burst.
THROTTLE_ANON_RATE=120/min
